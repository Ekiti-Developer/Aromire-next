NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
SANITY_API_TOKEN=your-sanity-token
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-secret
# Canonical origin for sitemap/robots. Never derived from request headers.
# SITE_URL is server-only and takes precedence when both are set.
SITE_URL=https://your-site.example
NEXT_PUBLIC_SITE_URL=https://your-site.example
BREVO_API_KEY=your-brevo-api-key
BREVO_CONTACT_LIST_ID=your-newsletter-list-id
BREVO_VOLUNTEER_LIST_ID=your-volunteer-list-id
BREVO_DONATION_LIST_ID=your-donation-list-id
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=Aromire-Eko
BREVO_RECIPIENT_EMAIL=inbox@example.com

# Number of trusted proxies in front of the app for rate limiting.
# 0 (default) ignores X-Forwarded-For entirely; set to 1 behind a single
# edge proxy (e.g. Vercel/Cloudflare) or to your actual trusted hop count.
TRUSTED_PROXY_HOPS=0

# Protect the embedded Sanity Studio at /studio with HTTP Basic auth.
# Without both values the Studio is disabled (404) in production.
STUDIO_USER=editor
STUDIO_PASSWORD=replace-with-a-long-random-password
